# Optional public MamaBot contact numbers shown in the app.
# Use international digits including Zimbabwe's 263 prefix, without "+".
# Leave blank to hide the corresponding button.
EXPO_PUBLIC_MAMABOT_WHATSAPP_NUMBER=
EXPO_PUBLIC_MAMABOT_SMS_NUMBER=

# Public HTTPS origin override for the Flask backend (no trailing slash).
# The app defaults to this backend if the variable is unset.
EXPO_PUBLIC_MAMABOT_API_URL=https://mama-backend-fg8v.onrender.com
