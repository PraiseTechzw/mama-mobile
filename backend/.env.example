# Required by the Flask Twilio webhooks.
# Find this token in the Twilio Console. Keep it secret.
TWILIO_AUTH_TOKEN=

# Required: public HTTPS origin used to validate Twilio webhook signatures.
# No trailing slash; for local tests use your HTTPS tunnel URL.
TWILIO_WEBHOOK_BASE_URL=

# Optional OpenRouter-powered language/topic classification.
# Create an API key in OpenRouter; never put it in the Expo app.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=perplexity/pplx-decider-v1.3:free

# Enables automatic language/topic detection for WhatsApp/SMS. Messages are
# sent to OpenRouter for classification; disclose this to users.
OPENROUTER_MESSAGING_ENABLED=true

# Optional PostgreSQL-backed WhatsApp/SMS language choice (24-hour inactivity expiry).
# Configure both values to enable the language-selection flow.
DATABASE_URL=postgresql://neondb_owner:npg_w21XbgsJMjEp@ep-purple-bar-beossi2l-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
LANGUAGE_SESSION_HASH_KEY=31ca1e894b26dafd84a69e1962bfee88d7ec9dc3e1610c1b9de6d6a22dd4d809
